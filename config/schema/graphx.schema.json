{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphx.dev/schema/graphx-v1.schema.json",
  "title": "GraphX configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "graph", "transport"],
  "properties": {
    "version": { "const": 1 },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodes", "edges"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nodes": {
          "type": "array", "minItems": 1, "maxItems": 1024,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array", "maxItems": 4096,
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tcp": { "type": "object", "additionalProperties": { "$ref": "#/$defs/tcp" } },
        "udp": { "type": "object", "additionalProperties": { "$ref": "#/$defs/udp" } },
        "unix": { "type": "object", "additionalProperties": { "$ref": "#/$defs/unix" } },
        "in_process": { "type": "object", "additionalProperties": { "$ref": "#/$defs/inProcess" } },
        "shared_memory": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sharedMemory" } }
      }
    },
    "network": { "$ref": "#/$defs/networkInfrastructure" },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": { "type": "string", "minLength": 1, "maxLength": 128 },
        "services": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/service" }
        },
        "telemetry": { "$ref": "#/$defs/telemetry" }
      }
    },
    "observability": { "$ref": "#/$defs/observability" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "port": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "direction", "schema"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "direction": { "enum": ["input", "output"] },
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "ports"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "ports": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/port" } }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "transport"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}\\.[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "to": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}\\.[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "transport": { "enum": ["tcp", "udp", "unix", "in_process", "shared_memory"] }
      }
    },
    "tcp": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "bind", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "bind": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "framing": { "const": "u32be" },
        "connect_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "send_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "reconnect": { "type": "boolean" },
        "retry": { "$ref": "#/$defs/tcpRetry" },
        "tls": { "$ref": "#/$defs/tcpTls" }
      }
    },
    "tcpTls": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "verify_peer": { "type": "boolean" },
        "require_client_certificate": { "type": "boolean" },
        "ca_file": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "certificate_file": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "private_key_file": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "server_name": { "type": "string", "minLength": 1, "maxLength": 253 }
      }
    },
    "tcpRetry": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "initial_backoff_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "max_backoff_ms": { "type": "integer", "minimum": 0, "maximum": 600000 }
      }
    },
    "udp": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "destination", "bind", "port"],
      "properties": {
        "mode": { "enum": ["unicast", "broadcast", "multicast"] },
        "destination": { "type": "string", "pattern": "^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}$", "minLength": 7, "maxLength": 15 },
        "bind": { "type": "string", "pattern": "^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}$", "minLength": 7, "maxLength": 15 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "interface": { "type": "string", "maxLength": 15 },
        "ttl": { "type": "integer", "minimum": 0, "maximum": 255 },
        "loopback": { "type": "boolean" },
        "reuse_address": { "type": "boolean" },
        "receive_buffer_bytes": { "type": "integer", "minimum": 4096, "maximum": 268435456 },
        "send_buffer_bytes": { "type": "integer", "minimum": 4096, "maximum": 268435456 },
        "max_datagram_bytes": { "type": "integer", "minimum": 64, "maximum": 65507 },
        "framing": { "const": "u32be" }
      }
    },
    "unix": {
      "type": "object", "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 103 },
        "framing": { "const": "u32be" },
        "connect_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "send_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 }
      }
    },
    "inProcess": {
      "type": "object", "additionalProperties": false,
      "required": ["channel"],
      "properties": {
        "channel": { "$ref": "#/$defs/id" },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "backpressure": { "enum": ["block", "reject"] },
        "send_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 }
      }
    },
    "sharedMemory": {
      "type": "object", "additionalProperties": false,
      "required": ["segment"],
      "properties": {
        "segment": { "type": "string", "pattern": "^/?[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_message_bytes": { "type": "integer", "minimum": 64, "maximum": 16777220 },
        "backpressure": { "enum": ["block", "reject"] },
        "connect_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "send_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 }
      }
    },
    "networkInfrastructure": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "networks": { "type": "array", "items": { "$ref": "#/$defs/networkDefinition" } },
        "switches": { "type": "array", "items": { "$ref": "#/$defs/switchDefinition" } },
        "routers": { "type": "array", "items": { "$ref": "#/$defs/routerDefinition" } },
        "interfaces": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/networkInterface" } }
        },
        "edge_paths": {
          "type": "object",
          "additionalProperties": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "networkDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "driver"],
      "allOf": [
        {
          "oneOf": [
            { "required": ["subnet"] },
            { "required": ["subnets"] }
          ]
        },
        {
          "if": {
            "required": ["driver", "mode"],
            "properties": { "driver": { "const": "ipvlan" }, "mode": { "enum": ["l3", "l3s"] } }
          },
          "then": {},
          "else": { "required": ["gateway"] }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "driver": { "enum": ["bridge", "macvlan", "ipvlan"] },
        "subnet": { "type": "string", "minLength": 1, "maxLength": 43 },
        "subnets": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 43 }
        },
        "gateway": { "type": "string", "minLength": 1, "maxLength": 39 },
        "parent": { "type": "string", "minLength": 1, "maxLength": 15 },
        "mode": { "enum": ["l2", "l3", "l3s"] },
        "external": { "type": "boolean" }
      }
    },
    "vlan": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "access_tag": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "trunks": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 4094 } }
      }
    },
    "switchPort": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "interface"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "interface": { "type": "string", "minLength": 1, "maxLength": 15 },
        "peer": { "type": "string", "minLength": 1, "maxLength": 15 },
        "vlan": { "$ref": "#/$defs/vlan" }
      }
    },
    "switchDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "ports"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 15 },
        "kind": { "const": "openvswitch" },
        "datapath": { "enum": ["system", "netdev"] },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/switchPort" } },
        "mirror": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "output_port"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "output_port": { "$ref": "#/$defs/id" },
            "select_all": { "type": "boolean" }
          }
        }
      }
    },
    "routerInterface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "network", "address", "device", "peer", "switch"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "network": { "$ref": "#/$defs/id" },
        "address": { "type": "string", "minLength": 1, "maxLength": 43 },
        "device": { "type": "string", "minLength": 1, "maxLength": 15 },
        "peer": { "type": "string", "minLength": 1, "maxLength": 15 },
        "switch": { "type": "string", "minLength": 1, "maxLength": 15 }
      }
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["destination"],
      "properties": {
        "destination": { "type": "string", "minLength": 1, "maxLength": 43 },
        "via": { "type": "string", "minLength": 1, "maxLength": 39 },
        "device": { "type": "string", "minLength": 1, "maxLength": 15 }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "type": "string", "minLength": 1, "maxLength": 43 },
        "destination": { "type": "string", "minLength": 1, "maxLength": 43 },
        "action": { "enum": ["accept", "drop"] }
      }
    },
    "routerDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "interfaces"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["linux_namespace", "container"] },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 64 },
        "forwarding": { "type": "boolean" },
        "interfaces": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/routerInterface" } },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
        "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } }
      }
    },
    "networkInterface": {
      "type": "object", "additionalProperties": false, "required": ["id", "network"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "network": { "$ref": "#/$defs/id" },
        "address": { "type": "string", "minLength": 1, "maxLength": 43 },
        "mac": { "type": "string", "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$" }
      }
    },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "command"],
      "properties": {
        "image": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "command": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "port"],
      "properties": {
        "service": { "type": "string", "minLength": 1, "maxLength": 128 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "observabilitySignal": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "exporters": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["console", "udp-json", "otlp-http"] }
        }
      }
    },
    "observability": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "metrics": {
          "allOf": [{ "$ref": "#/$defs/observabilitySignal" }],
          "properties": { "exporters": { "items": { "enum": ["console", "udp-json"] } } }
        },
        "tracing": { "$ref": "#/$defs/observabilitySignal" },
        "telemetry": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "host": { "type": "string", "minLength": 1, "maxLength": 253 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "websocket": { "type": "string", "pattern": "^/", "maxLength": 128 },
            "heartbeat_interval_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
            "heartbeat_timeout_ms": { "type": "integer", "minimum": 2, "maximum": 3600000 }
          }
        },
        "capture": {
          "type": "object", "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "required": ["provider"] }
            },
            {
              "if": {
                "properties": { "enabled": { "const": true }, "provider": { "const": "pcapng" } },
                "required": ["enabled", "provider"]
              },
              "then": { "required": ["directory"] }
            }
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { "type": "string", "enum": ["pcapng", "ovs-span"] },
            "directory": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "snaplen": { "type": "integer", "minimum": 256, "maximum": 16777220 },
            "max_file_bytes": { "type": "integer", "minimum": 65536, "maximum": 4294967296 },
            "max_packets": { "type": "integer", "minimum": 1, "maximum": 100000000 }
          }
        },
        "otlp": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoint": { "type": "string", "pattern": "^https?://(\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9.-]+)(:[0-9]{1,5})?/?$", "maxLength": 2048 },
            "traces_path": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$", "maxLength": 256 },
            "metrics_path": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$", "maxLength": 256 },
            "export_interval_ms": { "type": "integer", "minimum": 250, "maximum": 600000 },
            "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "queue_capacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "max_queue_bytes": { "type": "integer", "minimum": 65536, "maximum": 67108864 },
            "max_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 4194304 },
            "retry_max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "retry_initial_backoff_ms": { "type": "integer", "minimum": 10, "maximum": 60000 },
            "retry_max_backoff_ms": { "type": "integer", "minimum": 10, "maximum": 600000 }
          }
        },
        "slos": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "window_seconds": { "type": "integer", "minimum": 10, "maximum": 3600 },
            "minimum_window_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "availability_target": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_error_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_drop_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_p95_latency_us": { "type": "integer", "minimum": 1, "maximum": 3600000000 }
          }
        },
        "history": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "backend": { "const": "sqlite" },
            "database_file": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "retention_seconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
            "max_records": { "type": "integer", "minimum": 10, "maximum": 10000000 },
            "max_database_bytes": { "type": "integer", "minimum": 1048576, "maximum": 4294967296 },
            "queue_capacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "max_queue_bytes": { "type": "integer", "minimum": 65536, "maximum": 67108864 },
            "batch_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "flush_interval_ms": { "type": "integer", "minimum": 10, "maximum": 60000 },
            "query_limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "query_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 10000 },
            "max_pending_queries": { "type": "integer", "minimum": 1, "maximum": 128 },
            "shutdown_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 10000 }
          }
        },
        "control": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "command_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000 },
            "command_retention_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "max_commands": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "max_audit_records": { "type": "integer", "minimum": 10, "maximum": 100000 },
            "idempotency_ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "max_request_bytes": { "type": "integer", "minimum": 256, "maximum": 16384 }
          }
        }
      }
    }
  }
}
