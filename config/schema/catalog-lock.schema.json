{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binary_identity_status": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "design_only": {
      "type": "boolean"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "revision": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "revision",
    "design_only",
    "binary_identity_status",
    "files"
  ],
  "type": "object"
}
