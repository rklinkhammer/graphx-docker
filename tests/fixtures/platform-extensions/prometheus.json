{
  "global": {
    "scrape_interval": "5s"
  },
  "rule_files": [
    "/etc/prometheus/alerts.json"
  ],
  "scrape_configs": [
    {
      "authorization": {
        "credentials_file": "/run/secrets/observer/token"
      },
      "job_name": "graphx",
      "static_configs": [
        {
          "targets": [
            "platform:8080"
          ]
        }
      ]
    }
  ]
}
