{
  "allowed_consumers": {
    "lab-processor": [
      "processor"
    ],
    "lab-radio": [
      "radio"
    ],
    "observer": [
      "platform",
      "reader"
    ],
    "runtime-processor": [
      "platform",
      "processor"
    ],
    "runtime-radio": [
      "platform",
      "radio"
    ],
    "runtime-sink": [
      "platform",
      "sink"
    ]
  },
  "bundle_contract": {
    "directory_mode": "0500",
    "file_mode": "0400",
    "publication": "atomic member replacement inside stable credential directory",
    "rotation": "current and previous members with bounded monotonic grace",
    "staging_mode": "0700"
  },
  "deny_inline_values": true,
  "entries": {
    "lab-processor": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/lab-processor/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/lab-processor/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/lab-processor/key.pem"
      },
      "identity": "processor",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated",
      "tls_roles": [
        "clientAuth"
      ]
    },
    "lab-radio": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/lab-radio/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/lab-radio/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/lab-radio/key.pem"
      },
      "identity": "radio",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated",
      "tls_roles": [
        "serverAuth"
      ]
    },
    "observer": {
      "files": {
        "token": "${GX_CREDENTIALS}/observer/token"
      },
      "identity": "reader",
      "members": [
        "token"
      ],
      "provider": "runtime-generated"
    },
    "runtime-processor": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-processor/hmac"
      },
      "identity": "processor",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-radio": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-radio/hmac"
      },
      "identity": "radio",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-sink": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-sink/hmac"
      },
      "identity": "sink",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    }
  },
  "version": 1
}
