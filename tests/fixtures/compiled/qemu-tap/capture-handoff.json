{
  "api": "export_owned_network_capture",
  "captures": [
    {
      "destination": "${GX_STATE}/handoff/qemu-span.pcapng",
      "id": "qemu-span",
      "interval_seconds": 5,
      "max_bytes": 67108864
    }
  ],
  "permissions": "sealed read-only snapshots to platform group; live rings remain privileged",
  "version": 1
}
