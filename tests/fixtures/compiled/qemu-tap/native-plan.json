{
  "owner_api": "owned-process-adapter",
  "processes": [
    {
      "argv": [
        "${GX_RELEASE}/bin/graphx-packet-peer",
        "--node",
        "host-peer",
        "--config",
        "${GX_OUTPUT}/nodes/host-peer.json",
        "--release-file",
        "${GX_STATE}/barriers/release",
