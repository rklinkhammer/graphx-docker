{
  "allowed_consumers": {
    "observer": [
      "platform",
      "reader"
    ],
    "runtime-generator": [
      "generator",
      "platform"
    ],
    "runtime-sink": [
      "platform",
      "sink"
    ],
    "runtime-transform": [
      "platform",
      "transform"
    ]
  },
  "bundle_contract": {
    "directory_mode": "0500",
    "file_mode": "0400",
    "publication": "atomic member replacement inside stable credential directory",
    "rotation": "current and previous members with bounded monotonic grace",
    "staging_mode": "0700"
  },
  "deny_inline_values": true,
  "entries": {
    "observer": {
      "files": {
        "token": "${GX_CREDENTIALS}/observer/token"
      },
      "identity": "reader",
      "members": [
        "token"
      ],
      "provider": "runtime-generated"
    },
    "runtime-generator": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-generator/hmac"
      },
      "identity": "generator",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-sink": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-sink/hmac"
      },
      "identity": "sink",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-transform": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-transform/hmac"
      },
      "identity": "transform",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    }
  },
  "version": 1
}
