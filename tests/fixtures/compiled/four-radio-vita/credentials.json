{
  "allowed_consumers": {
    "controller": [
      "processor"
    ],
    "observer": [
      "platform",
      "reader"
    ],
    "radio": [
      "radio1",
      "radio2",
      "radio3",
      "radio4"
    ],
    "runtime-detector": [
      "detector",
      "platform"
    ],
    "runtime-processor": [
      "platform",
      "processor"
    ],
    "runtime-radio1": [
      "platform",
      "radio1"
    ],
    "runtime-radio2": [
      "platform",
      "radio2"
    ],
    "runtime-radio3": [
      "platform",
      "radio3"
    ],
    "runtime-radio4": [
      "platform",
      "radio4"
    ],
    "runtime-recorder": [
      "platform",
      "recorder"
    ]
  },
  "bundle_contract": {
    "directory_mode": "0500",
    "file_mode": "0400",
    "publication": "atomic member replacement inside stable credential directory",
    "rotation": "current and previous members with bounded monotonic grace",
    "staging_mode": "0700"
  },
  "deny_inline_values": true,
  "entries": {
    "controller": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/controller/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/controller/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/controller/key.pem"
      },
      "identity": "controller",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated",
      "tls_roles": [
        "clientAuth"
      ]
    },
    "observer": {
      "files": {
        "token": "${GX_CREDENTIALS}/observer/token"
      },
      "identity": "reader",
      "members": [
        "token"
      ],
      "provider": "runtime-generated"
    },
    "radio": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/radio/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/radio/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/radio/key.pem"
      },
      "identity": "radio",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated",
      "tls_roles": [
        "serverAuth"
      ]
    },
    "runtime-detector": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-detector/hmac"
      },
      "identity": "detector",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-processor": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-processor/hmac"
      },
      "identity": "processor",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-radio1": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-radio1/hmac"
      },
      "identity": "radio1",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-radio2": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-radio2/hmac"
      },
      "identity": "radio2",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-radio3": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-radio3/hmac"
      },
      "identity": "radio3",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-radio4": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-radio4/hmac"
      },
      "identity": "radio4",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-recorder": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-recorder/hmac"
      },
      "identity": "recorder",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    }
  },
  "version": 1
}
