FROM python:3.13-alpine@sha256:7415fbc3c9e4979cc717d92377ab2bc7b2b4a2af1ac03cc52b5f3f88efedaf3a

LABEL org.opencontainers.image.title="GraphX QEMU demo services" \
      org.opencontainers.image.description="Shared raw endpoints and passive packet observer"

RUN addgroup -S -g 65532 graphx && adduser -S -D -H -u 65532 -G graphx graphx
WORKDIR /opt/graphx-qemu
COPY examples/qemu-node/host/peer.py examples/qemu-node/host/relay.py ./host/
COPY examples/qemu-node/tools/packet_observer.py ./tools/
USER 65532:65532
ENTRYPOINT ["python3"]
