# syntax=docker/dockerfile:1.7
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates python3 qemu-system-x86 \
 && rm -rf /var/lib/apt/lists/*

COPY docker/install-build-trust.sh /usr/local/libexec/graphx-install-build-trust
ARG GRAPHX_BUILD_TRUST_FINGERPRINT=graphx-trust-v1-none
RUN --mount=type=secret,id=graphx_ca,required=false \
    --mount=type=secret,id=graphx_cert_installer,required=false \
    /bin/bash /usr/local/libexec/graphx-install-build-trust

RUN groupadd --gid 65532 graphx && useradd --uid 65532 --gid 65532 --no-create-home graphx \
 && mkdir -p /artifacts /captures /run/graphx-qemu \
 && chown -R 65532:65532 /captures /run/graphx-qemu
COPY --chown=65532:65532 examples/qemu-node/host/peer.py examples/qemu-node/host/relay.py /opt/graphx-qemu/host/
COPY --chown=65532:65532 examples/qemu-node/tools/qmp_control.py examples/qemu-node/tools/artifact_manifest.py /opt/graphx-qemu/tools/
COPY --chown=65532:65532 examples/qemu-node/container/qemu-entrypoint.sh /usr/local/bin/qemu-entrypoint
COPY --chown=65532:65532 examples/qemu-node/container/qemu-healthcheck.sh /usr/local/bin/qemu-healthcheck
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/qemu-entrypoint"]
