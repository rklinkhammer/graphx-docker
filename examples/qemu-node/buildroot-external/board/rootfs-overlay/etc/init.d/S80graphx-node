#!/bin/sh

pid_file=/var/run/qemu-network-node.pid

case "$1" in
  start)
    echo "Starting external raw TCP/UDP node"
    /usr/bin/qemu-network-node >/dev/console 2>&1 &
    echo "$!" >"$pid_file"
    ;;
  stop)
    if [ -r "$pid_file" ]; then
      kill "$(cat "$pid_file")" 2>/dev/null || true
      rm -f "$pid_file"
    fi
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac
