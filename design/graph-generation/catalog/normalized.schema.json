{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "connections": {
      "items": {
        "type": "object"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "contract_version": {
      "const": 2
    },
    "credential_references": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "execution_values": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "graph_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "graph_version": {
      "const": 3
    },
    "input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "network": {
      "type": "object"
    },
    "nodes": {
      "items": {
        "type": "object"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "ordering": {
      "const": "lexicographic-ascii"
    },
    "platform": {
      "type": "object"
    },
    "portable_network": {
      "type": [
        "object",
        "null"
      ]
    },
    "target": {
      "enum": [
        "native-linux",
        "native-macos",
        "orbstack",
        "lima"
      ]
    }
  },
  "required": [
    "contract_version",
    "graph_version",
    "graph_id",
    "target",
    "catalog_digest",
    "input_digest",
    "nodes",
    "connections",
    "network",
    "portable_network",
    "platform",
    "credential_references",
    "ordering",
    "execution_values"
  ],
  "title": "DESIGN ONLY normalized contract 2 for graph version 3",
  "type": "object"
}
