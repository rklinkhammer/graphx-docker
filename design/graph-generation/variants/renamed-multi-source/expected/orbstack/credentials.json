{
  "allowed_consumers": {
    "observer": [
      "reader",
      "platform"
    ],
    "runtime-processor-east": [
      "processor-east",
      "platform"
    ],
    "runtime-processor-west": [
      "processor-west",
      "platform"
    ],
    "runtime-recorder-east": [
      "recorder-east",
      "platform"
    ],
    "runtime-recorder-west": [
      "recorder-west",
      "platform"
    ],
    "runtime-source-east": [
      "source-east",
      "platform"
    ],
    "runtime-source-west": [
      "source-west",
      "platform"
    ]
  },
  "bundle_contract": {
    "grace_clock": "execution monotonic deadline; never compiler timestamp",
    "metadata": "credential bundle metadata only; not a resource lifecycle ledger",
    "mode": "directory 0500 and files 0400 owned by service UID; staging parent 0700",
    "mount_scope": "one read-only directory per authorized reference",
    "publication": "atomic rename of member files inside stable bound directory; never rename the directory",
    "retention": "at most current and previous per member; remove previous after grace",
    "rotation": "publish previous member plus grace metadata, then current; readers reload on bundle generation change; bounded retries on generation mismatch"
  },
  "deny_inline_values": true,
  "entries": {
    "observer": {
      "files": {
        "token": "${GX_CREDENTIALS}/observer/token"
      },
      "identity": "reader",
      "members": [
        "token"
      ],
      "provider": "runtime-generated"
    },
    "runtime-processor-east": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-processor-east/hmac"
      },
      "identity": "processor-east",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-processor-west": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-processor-west/hmac"
      },
      "identity": "processor-west",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-recorder-east": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-recorder-east/hmac"
      },
      "identity": "recorder-east",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-recorder-west": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-recorder-west/hmac"
      },
      "identity": "recorder-west",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-source-east": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-source-east/hmac"
      },
      "identity": "source-east",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-source-west": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-source-west/hmac"
      },
      "identity": "source-west",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    }
  },
  "version": 1
}
