{
  "allowed_consumers": {
    "observer": [
      "reader",
      "platform"
    ],
    "processor-east": [
      "processor-east"
    ],
    "processor-west": [
      "processor-west"
    ],
    "radio-east": [
      "radio-east"
    ],
    "radio-west": [
      "radio-west"
    ],
    "runtime-processor-east": [
      "processor-east",
      "platform"
    ],
    "runtime-processor-west": [
      "processor-west",
      "platform"
    ],
    "runtime-radio-west": [
      "radio-west",
      "platform"
    ],
    "runtime-sink-east": [
      "sink-east",
      "platform"
    ],
    "runtime-sink-west": [
      "sink-west",
      "platform"
    ]
  },
  "bundle_contract": {
    "grace_clock": "execution monotonic deadline; never compiler timestamp",
    "metadata": "credential bundle metadata only; not a resource lifecycle ledger",
    "mode": "directory 0500 and files 0400 owned by service UID; staging parent 0700",
    "mount_scope": "one read-only directory per authorized reference",
    "publication": "atomic rename of member files inside stable bound directory; never rename the directory",
    "retention": "at most current and previous per member; remove previous after grace",
    "rotation": "publish previous member plus grace metadata, then current; readers reload on bundle generation change; bounded retries on generation mismatch"
  },
  "deny_inline_values": true,
  "entries": {
    "observer": {
      "files": {
        "token": "${GX_CREDENTIALS}/observer/token"
      },
      "identity": "reader",
      "members": [
        "token"
      ],
      "provider": "runtime-generated"
    },
    "processor-east": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/processor-east/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/processor-east/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/processor-east/key.pem"
      },
      "identity": "processor-east",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated"
    },
    "processor-west": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/processor-west/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/processor-west/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/processor-west/key.pem"
      },
      "identity": "processor-west",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated"
    },
    "radio-east": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/radio-east/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/radio-east/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/radio-east/key.pem"
      },
      "identity": "radio-east",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated"
    },
    "radio-west": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/radio-west/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/radio-west/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/radio-west/key.pem"
      },
      "identity": "radio-west",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated"
    },
    "runtime-processor-east": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-processor-east/hmac"
      },
      "identity": "processor-east",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-processor-west": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-processor-west/hmac"
      },
      "identity": "processor-west",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-radio-west": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-radio-west/hmac"
      },
      "identity": "radio-west",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-sink-east": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-sink-east/hmac"
      },
      "identity": "sink-east",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-sink-west": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-sink-west/hmac"
      },
      "identity": "sink-west",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    }
  },
  "version": 1
}
