{
  "allowed_consumers": {
    "observer": [
      "reader",
      "platform"
    ],
    "operator": [
      "operator",
      "platform"
    ],
    "operator-next": [
      "operator",
      "platform"
    ],
    "runtime-generator": [
      "generator",
      "platform"
    ],
    "runtime-generator-next": [
      "generator",
      "platform"
    ],
    "runtime-sink": [
      "sink",
      "platform"
    ],
    "runtime-transform": [
      "transform",
      "platform"
    ]
  },
  "bundle_contract": {
    "grace_clock": "execution monotonic deadline; never compiler timestamp",
    "metadata": "credential bundle metadata only; not a resource lifecycle ledger",
    "mode": "directory 0500 and files 0400 owned by service UID; staging parent 0700",
    "mount_scope": "one read-only directory per authorized reference",
    "publication": "atomic rename of member files inside stable bound directory; never rename the directory",
    "retention": "at most current and previous per member; remove previous after grace",
    "rotation": "publish previous member plus grace metadata, then current; readers reload on bundle generation change; bounded retries on generation mismatch"
  },
  "deny_inline_values": true,
  "entries": {
    "observer": {
      "files": {
        "token": "${GX_CREDENTIALS}/observer/token"
      },
      "identity": "reader",
      "members": [
        "token"
      ],
      "provider": "runtime-generated"
    },
    "operator": {
      "files": {
        "token": "${GX_CREDENTIALS}/operator/token"
      },
      "identity": "operator",
      "members": [
        "token"
      ],
      "provider": "external"
    },
    "operator-next": {
      "files": {
        "token": "${GX_CREDENTIALS}/operator-next/token"
      },
      "identity": "operator",
      "members": [
        "token"
      ],
      "provider": "external"
    },
    "runtime-generator": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-generator/hmac"
      },
      "identity": "generator",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-generator-next": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-generator-next/hmac"
      },
      "identity": "generator",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-sink": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-sink/hmac"
      },
      "identity": "sink",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-transform": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-transform/hmac"
      },
      "identity": "transform",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    }
  },
  "version": 1
}
