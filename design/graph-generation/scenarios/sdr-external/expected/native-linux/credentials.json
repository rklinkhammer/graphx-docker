{
  "allowed_consumers": {
    "lab-processor": [
      "processor"
    ],
    "lab-radio": [
      "radio"
    ],
    "observer": [
      "reader",
      "platform"
    ],
    "runtime-processor": [
      "processor",
      "platform"
    ],
    "runtime-sink": [
      "sink",
      "platform"
    ],
    "test-processor": [
      "processor"
    ],
    "test-radio": [
      "sdr-node"
    ]
  },
  "bundle_contract": {
    "grace_clock": "execution monotonic deadline; never compiler timestamp",
    "metadata": "credential bundle metadata only; not a resource lifecycle ledger",
    "mode": "directory 0500 and files 0400 owned by service UID; staging parent 0700",
    "mount_scope": "one read-only directory per authorized reference",
    "publication": "atomic rename of member files inside stable bound directory; never rename the directory",
    "retention": "at most current and previous per member; remove previous after grace",
    "rotation": "publish previous member plus grace metadata, then current; readers reload on bundle generation change; bounded retries on generation mismatch"
  },
  "deny_inline_values": true,
  "entries": {
    "lab-processor": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/lab-processor/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/lab-processor/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/lab-processor/key.pem"
      },
      "identity": "processor",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "external"
    },
    "lab-radio": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/lab-radio/ca.pem"
      },
      "identity": "radio",
      "members": [
        "ca.pem"
      ],
      "note": "Device private key stays on physical device; never provisioned by GraphX",
      "provider": "external"
    },
    "observer": {
      "files": {
        "token": "${GX_CREDENTIALS}/observer/token"
      },
      "identity": "reader",
      "members": [
        "token"
      ],
      "provider": "runtime-generated"
    },
    "runtime-processor": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-processor/hmac"
      },
      "identity": "processor",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "runtime-sink": {
      "files": {
        "hmac": "${GX_CREDENTIALS}/runtime-sink/hmac"
      },
      "identity": "sink",
      "members": [
        "hmac"
      ],
      "provider": "runtime-generated"
    },
    "test-processor": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/test-processor/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/test-processor/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/test-processor/key.pem"
      },
      "identity": "processor",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated"
    },
    "test-radio": {
      "files": {
        "ca.pem": "${GX_CREDENTIALS}/test-radio/ca.pem",
        "cert.pem": "${GX_CREDENTIALS}/test-radio/cert.pem",
        "key.pem": "${GX_CREDENTIALS}/test-radio/key.pem"
      },
      "identity": "sdr-node",
      "members": [
        "ca.pem",
        "cert.pem",
        "key.pem"
      ],
      "provider": "lab-generated"
    }
  },
  "version": 1
}
